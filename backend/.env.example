# VYUH backend environment (copy to .env)
DEMO_MODE=true
VYUH_ALLOW_SIM_OVERRIDE=true
VYUH_CRUMB_SECRET=change-me-to-a-random-32-char-secret
JWT_KEY=change-me-to-a-random-jwt-secret
GOOGLE_CLIENT_ID=

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Wazuh / OpenSearch Indexer (self-signed -> verify disabled)
WAZUH_MODE=mock
WAZUH_INDEXER_URL=https://10.46.34.107:9200
WAZUH_USERNAME=admin
WAZUH_PASSWORD=admin
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_VERIFY=false
WAZUH_ROUNDTRIP_ENABLED=true
WAZUH_TIMEOUT_SECONDS=1.5
WAZUH_ENABLE_DEV_REPLAY=false
WAZUH_POLL_SECONDS=30

# DeepSeek LLM kernel (optional; deterministic fallback when unset)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4.1-flash:free
DEEPSEEK_TIMEOUT_SECONDS=45
